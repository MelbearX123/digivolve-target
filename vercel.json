{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "server",
      "framework": "fastapi",
      "entrypoint": "api.main:app"
    },
    "ui": {
      "root": "ui",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "ui" } }
  ]
}
